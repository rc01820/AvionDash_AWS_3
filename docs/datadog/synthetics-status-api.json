{
  "name": "[AvionPulse] Public status page",
  "type": "api",
  "subtype": "http",
  "status": "live",
  "message": "AvionPulse public status page is failing from {{#is_alert}}{{locations.size}} location(s){{/is_alert}}.\n\nRunbook: open https://<SITE_HOST>/status. A 500 with 'the status page is unavailable' = the status_page_error fault (Chaos Control) or a Lambda problem; check /api/health and the [AvionPulse] monitors. Chaos panel: https://<SITE_HOST>/#chaos\n\n@your-email",
  "tags": ["app:avionpulse", "env:demo", "service:avionpulse", "fault:status_page_error", "check:status-page"],
  "locations": ["aws:us-east-1", "aws:eu-west-1"],
  "config": {
    "request": {
      "method": "GET",
      "url": "https://<SITE_HOST>/status",
      "timeout": 10
    },
    "assertions": [
      { "type": "statusCode", "operator": "is", "target": 200 },
      { "type": "responseTime", "operator": "lessThan", "target": 3000 },
      { "type": "header", "property": "content-type", "operator": "contains", "target": "text/html" },
      { "type": "body", "operator": "contains", "target": "AvionPulse Status" }
    ]
  },
  "options": {
    "tick_every": 300,
    "min_failure_duration": 0,
    "min_location_failed": 1,
    "retry": { "count": 1, "interval": 30000 },
    "follow_redirects": true,
    "monitor_name": "[AvionPulse] Public status page",
    "monitor_priority": 1,
    "monitor_options": { "renotify_interval": 30 }
  }
}
